# LLM provider (required — get a free key from https://console.groq.com/keys)
# Pick one:

# Option A: Groq (free, no credit card — recommended)
FALA_BASE_URL=https://api.groq.com/openai/v1
FALA_API_KEY=gsk_your-key-here
FALA_MODEL=llama-3.3-70b-versatile

# Option B: OpenAI (free $5 credits, requires credit card)
# OPENAI_API_KEY=sk-...

# TTS (text-to-speech — optional, default: OpenAI cloud)
# Piper is a free local pt-PT voice. No API key needed.
# Install: pip install piper-tts
FALA_TTS=piper

# Kokoro alternative: free local pt-PT voice, more natural than Piper.
# Install: pip install tts_eu_pt  (first run downloads ~327 MB)
# FALA_TTS=kokoro

# Azure Speech (recommended for the hosted web app — dedicated pt-PT neural voices)
# Free tier ~0.5M chars/mo. Get a key: portal.azure.com -> Azure AI Speech.
# FALA_TTS=azure
# FALA_AZURE_KEY=your-azure-speech-key
# FALA_AZURE_REGION=westeurope
# FALA_AZURE_VOICE=pt-PT-FernandaNeural

# OpenAI TTS (alternative, needs its own OpenAI API key)
# FALA_TTS=openai
# FALA_TTS_VOICE=alloy

# STT (speech-to-text — optional, needs openai-whisper)
# FALA_STT_MODEL=base
# Cloud STT model for the API fallback (auto-detects Groq's whisper-large-v3-turbo
# when FALA_BASE_URL points at Groq; override if needed):
# FALA_STT_API_MODEL=whisper-1

# Web app auth (optional — comma-separated invite codes)
# When set, users must enter one of these codes to access the web app.
# Each code doubles as a user_id for per-user data isolation.
# FALA_INVITE_CODES=alex-beta-1,tester-2,friend-3

# Web app rate limit (optional — requests per minute per session/IP)
# Applies to /message, /stt, /tts and /auth. Default: 30.
# FALA_RATE_LIMIT_PER_MIN=30
